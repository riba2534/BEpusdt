# 监听地址，格式为 ip:port，例如 :8080
LISTEN=127.0.0.1:8080

# 后台管理入口路径，留空则首次安装时随机生成一段路径
# 配置后每次启动都会覆盖数据库中的旧入口，改这里即可换入口
# ADMIN_ENTRANCE=/my-panel

# 日志文件保存路径
LOG=/var/log/bepusdt/

# SQLite 数据库文件路径（如果使用 MySQL，此项可忽略）
SQLITE=/var/lib/bepusdt/sqlite.db

# PostgreSQL 数据库
# POSTGRESQL_DSN=postgres://user:password@localhost:5432/bepusdt?sslmode=disable&connect_timeout=3&timezone=Asia/Shanghai